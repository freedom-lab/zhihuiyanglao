<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view wx:for="{{tabList}}" wx:key="index" class="tab-bar-item" data-index="{{index}}" data-url="{{item.url}}" bindtap="handleTabClick">
    <!-- 图标区域 -->
    <image class="tab-bar-icon {{activeTab === index && index === 0 ? 'active-home' : ''}}" 
           src="{{activeTab === index ? item['active-icon'] : item['inactive-icon']}}" 
           mode="aspectFit"></image>
    <!-- 文字区域（首页选中时隐藏文字） -->
    <view class="tab-bar-text {{activeTab === index && index === 0 ? 'hide-text' : ''}}">{{item.text}}</view>
    <!-- 消息角标（仅“我的”tab显示） -->
    <view wx:if="{{index === 2 && messageNum > 0}}" class="badge">{{messageNum}}</view>
  </view>
</view>