<script>
export default {
  name: 'BuildingFloors',
  data() {
    return {
      buildingList: [
        { buildingName: '1 号楼', isBuilding: true, id: 1 },
        { floorName: '1F', isBuilding: false, parentId: 1 },
        { floorName: '2F', isBuilding: false, parentId: 1 },
        { floorName: '3F', isBuilding: false, parentId: 1 },
        { floorName: '4F', isBuilding: false, parentId: 1 },
        { floorName: '5F', isBuilding: false, parentId: 1 },
        { floorName: '6F', isBuilding: false, parentId: 1 },
        { buildingName: '2 号楼', isBuilding: true, id: 2 }
      ],
      roomList: [
        // { roomName: '101', area: 25.5, roomType: '单人间', id: 1 },
        // { roomName: '102', area: 30.0, roomType: '双人间', id: 2 },
        // { roomName: '103', area: 45.0, roomType: '三人间', id: 3 }
      ],
      bedList: [
        // { bedNo: '101-A', bedStatus: '空闲', id: 1 },
        // { bedNo: '101-B', bedStatus: '已入住', id: 2 },
        // { bedNo: '102-A', bedStatus: '空闲', id: 3 },
        // { bedNo: '102-B', bedStatus: '预定', id: 4 }
      ],
      // 床位数据源
      bedList: [
        {
          roomNo: "101",
          bedNum: 1,
          dayPrice: "0.00",
          monthPrice: "600.00",
          bedImg: "bed-empty-1.png", // 空床图片
          qrcodeImg: "@/assets/images/common/bed-qrcode.png",
          id: 1
        },
        {
          roomNo: "101",
          bedNum: 2,
          dayPrice: "0.00",
          monthPrice: "600.00",
          bedImg: "bed-empty-1.png",
          qrcodeImg: "@/assets/images/common/bed-qrcode.png",
          id: 2
        },
        {
          roomNo: "101",
          bedNum: 2,
          dayPrice: "0.00",
          monthPrice: "600.00",
          bedImg: "bed-empty-1.png",
          qrcodeImg: "@/assets/images/common/bed-qrcode.png",
          id: 2
        }
      ],
      // 楼栋弹窗显示控制
      buildAddDialogVisible: false,
      // 楼栋新增表单数据
      buildAddForm: {
        buildingName: "",
        floorTotal: "",
        locationDataId: "",
        mapBuildingId: "",
        indoorBeaconNum: "",
        outdoorBeaconNum: "",
        sort: "",
        remark: ""
      },
      buildAddFormRef: null,
      // 房间弹窗显示控制
      roomAddDialogVisible: false,
      // 房间新增表单数据
      roomAddForm: {
        roomName: "",
        roomArea: "",
        roomType: "",
        roomDirection: "",
        roomLight: "",
        roomVentilate: "",
        sort: "",
        remark: ""
      },
      roomAddFormRef: null,
      // 床位弹窗显示控制
      bedAddDialogVisible: false,
      // 房间新增表单数据
      bedAddForm: {
        bedName: "",
        bedType: "",
        dayPrice: "",
        monthPrice: "",
        roomLight: "",
        roomVentilate: "",
        sort: "",
        remark: ""
      },
      bedAddFormRef: null,
    }
  },
  mounted() {
    // 初始化数据加载
    console.log('页面已加载')
  },
  methods: {
    // 序号方法
    indexMethod(index) {
      return index + 1
    },
    // 获取房间类型标签颜色
    getRoomTypeTag(type) {
      const typeMap = {
        '单人间': '',
        '双人间': 'success',
        '三人间': 'warning',
        'VIP 间': 'danger'
      }
      return typeMap[type] || ''
    },
    // 获取床位状态标签颜色
    getBedStatusTag(status) {
      const statusMap = {
        '空闲': 'success',
        '已入住': 'danger',
        '预定': 'warning',
        '维修中': 'info'
      }
      return statusMap[status] || ''
    },
    // 打开新增弹窗，重置表单
    openAddDialog() {
      console.log('新增楼栋')
      this.buildAddDialogVisible = true;
      console.log("赋值后buildAddDialogVisible=", this.buildAddDialogVisible);
      // 清空表单校验
      this.$nextTick(() => {
        this.$refs.buildAddFormRef?.clearValidate();
        this.buildAddForm = {
          buildingName: "",
          floorTotal: "",
          locationDataId: "",
          mapBuildingId: "",
          indoorBeaconNum: "",
          outdoorBeaconNum: "",
          sort: "",
          remark: ""
        };
      });
    },
    // 提交保存
    submitAdd() {
      this.$refs.buildAddFormRef.validate(async valid => {
        if (!valid) return;
        // 此处写新增接口请求逻辑
        console.log("提交新增数据", this.buildAddForm);
        // 成功后关闭弹窗、刷新列表
        // await api.addBuilding(this.addForm)
        // this.addDialogVisible = false
        // this.getTableList()
      });
    },
    //删除楼栋
    deleteBuild() {
      this.$confirm('确定将选择数据删除?', '提示', {
        confirmButtonText: '确定',
        cancelButtonText: '取消',
        type: 'warning', // 黄色感叹号警告图标，和截图匹配
        closeOnClickModal: false,
      }).then(async () => {
        // 点击确定，执行删除接口
        // await api.delBuilding(id)
        this.$message.success('删除成功');
        // 刷新表格列表
        this.getTableList();
      }).catch(() => {
        // 点击取消，无操作
      })
    },
    //打开 新增房间弹窗
    openRoomDialog() {
      this.roomAddDialogVisible = true
    },
    //打开 编辑房间弹窗
    editRoomDialog() {

    },
    //删除房间数据
    deleteRoom() {

    },
    // 修改床位
    handleEdit(row) {
      console.log("编辑床位", row)
      // 弹窗/路由跳转逻辑
    },
    // 删除床位
    handleDelete(row) {
      this.$confirm(`确认删除${row.roomNo}房${row.bedNum}号床位？`, "提示", {
        type: "warning"
      }).then(() => {
        console.log("执行删除", row.id)
      }).catch(() => { })
    },
    //打开 床位弹窗
    openBedDialog() {
      this.bedAddDialogVisible = true
    }
  },
}
</script>

