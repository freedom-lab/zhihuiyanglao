        <el-table-column label="过敏史" align="center" min-width="130">
          <template slot-scope="scope">{{ scope.row.allergicHistory }}</template>
        </el-table-column>
        <el-table-column label="饮食习惯" align="center" min-width="90">
          <template slot-scope="scope">{{ scope.row.dietaryHabit }}</template>
