/* 环形饼图旋转动画 统一keyframe名称 */
.content {
    position: relative
}

.content .pei-inside {
    position: absolute;
    top: 55px;
    left: 55px;
    width: 70px;
    height: 70px;
    animation: rotateImage 8s linear infinite reverse
}

.content .pei-outer {
    width: 170px;
    height: 170px;
    position: absolute;
    top: 6px;
    left: 6px;
    -webkit-animation: rotateImage 15s linear infinite;
    animation: rotateImage 15s linear infinite
}

@-webkit-keyframes rotateImage {
    0% {
        -webkit-transform: rotate(0deg);
        transform: rotate(0deg)
    }
    to {
        -webkit-transform: rotate(1turn);
        transform: rotate(1turn)
    }
}

@keyframes rotateImage {
    0% {
        transform: rotate(0deg)
    }
    to {
        transform: rotate(1turn)
    }
}

