      this.initOrderChart()
      this.initTypeChart()
      this.initOrderChart2()
      this.initOrderChart3()
    })
    // 窗口缩放自适应图表
    window.addEventListener('resize', this.resizeAllChart)
  },
  beforeDestroy() {
    window.removeEventListener('resize', this.resizeAllChart)
    // 销毁echarts实例释放内存
    if(this.orderChart) this.orderChart.dispose()
    if(this.orderChart2) this.orderChart2.dispose()
    if(this.orderChart3) this.orderChart3.dispose()
    if(this.typeChart) this.typeChart.dispose()
