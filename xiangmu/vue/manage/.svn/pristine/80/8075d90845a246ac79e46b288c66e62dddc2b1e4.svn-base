        overflow: hidden;
        font-size: .7vw;
        cursor: pointer;
      }
      .bed-list:last-child {
        border-bottom: none;
      }
      .bed-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
        .el-icon-menu{
          color: #2E59FB;
        }
      }
      .tip {
        color: #fff;
        padding: 2px 8px;
        border-radius: 4px;
      }
      .block {
        // margin-top: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-top: 1px solid #eee;
      }
    }
  }
}
.content-top{
  height: 50px;
  background: #409eff;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  color: #fff;
  white-space: nowrap;
  border-radius: 3px;
  font-size: 16px;
  padding-right: 10px;
  ::v-deep .el-switch__label{
    color: #fff;
  }
  ::v-deep .el-switch__label.is-active{
    color: #fffc00;
