<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.CarePaymentDetailMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    institution_id,
    institution_name,
    elder_id,
    elder_name,
    payment_id,
    serial_code,
    item_id,
    item_name,
    item_price,
    fee_type,
    cost_type,
    is_refund,
    is_preferential,
    amount,
    preferential_amount,
    cost_amount,
    start_date,
    end_date,
    change_id,
    order_ids,
    area_code,
    area_name,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    status,
    is_deleted
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.institutionId},
    #{item.institutionName},
    #{item.elderId},
    #{item.elderName},
    #{item.paymentId},
    #{item.serialCode},
    #{item.itemId},
    #{item.itemName},
    #{item.itemPrice},
    #{item.feeType},
    #{item.costType},
    #{item.isRefund},
    #{item.isPreferential},
    #{item.amount},
    #{item.preferentialAmount},
    #{item.costAmount},
    #{item.startDate},
    #{item.endDate},
    #{item.changeId},
    #{item.orderIds},
    #{item.areaCode},
    #{item.areaName},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.status},
    #{item.isDeleted}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_care_payment_detail
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.CarePaymentDetail">
        SELECT * from  tb_jiangyukeji_care_payment_detail
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
