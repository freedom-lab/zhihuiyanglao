<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.InsDonateInfoMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    corp_name,
    institution_id,
    institution_name,
    donate_type,
    donate_way,
    donate_name,
    donate_amount,
    link_tel,
    donate_time,
    card_no,
    usage_describe,
    remark,
    create_user,
    create_name,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.corpName},
    #{item.institutionId},
    #{item.institutionName},
    #{item.donateType},
    #{item.donateWay},
    #{item.donateName},
    #{item.donateAmount},
    #{item.linkTel},
    #{item.donateTime},
    #{item.cardNo},
    #{item.usageDescribe},
    #{item.remark},
    #{item.createUser},
    #{item.createName},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_ins_donate_info
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.InsDonateInfo">
        SELECT * from  tb_jiangyukeji_ins_donate_info
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="corpId!=null and corpId!=''">
            and corp_id = #{corpId}
        </if>
        <if test="corpName!=null and corpName!=''">
            and corp_name = #{corpName}
        </if>
        <if test="institutionId!=null and institutionId!=''">
            and institution_id = #{institutionId}
        </if>
        <if test="institutionName!=null and institutionName!=''">
            and institution_name = #{institutionName}
        </if>
        <if test="donateType!=null and donateType!=''">
            and donate_type = #{donateType}
        </if>
        <if test="donateWay!=null and donateWay!=''">
            and donate_way = #{donateWay}
        </if>
        <if test="donateName!=null and donateName!=''">
            and donate_name = #{donateName}
        </if>
        <if test="donateAmount!=null and donateAmount!=''">
            and donate_amount = #{donateAmount}
        </if>
        <if test="linkTel!=null and linkTel!=''">
            and link_tel = #{linkTel}
        </if>
        <if test="donateTime!=null and donateTime!=''">
            and donate_time = #{donateTime}
        </if>
        <if test="cardNo!=null and cardNo!=''">
            and card_no = #{cardNo}
        </if>
        <if test="usageDescribe!=null and usageDescribe!=''">
            and usage_describe = #{usageDescribe}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createName!=null and createName!=''">
            and create_name = #{createName}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        </where>
        order by id desc limit #{pageSize} offset #{offset}
    </select>

    <select id="queryPageCount" parameterType="java.util.Map" resultType="java.lang.Integer">
        SELECT count(*) from tb_jiangyukeji_ins_donate_info
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="corpId!=null and corpId!=''">
            and corp_id = #{corpId}
        </if>
        <if test="corpName!=null and corpName!=''">
            and corp_name = #{corpName}
        </if>
        <if test="institutionId!=null and institutionId!=''">
            and institution_id = #{institutionId}
        </if>
        <if test="institutionName!=null and institutionName!=''">
            and institution_name = #{institutionName}
        </if>
        <if test="donateType!=null and donateType!=''">
            and donate_type = #{donateType}
        </if>
        <if test="donateWay!=null and donateWay!=''">
            and donate_way = #{donateWay}
        </if>
        <if test="donateName!=null and donateName!=''">
            and donate_name = #{donateName}
        </if>
        <if test="donateAmount!=null and donateAmount!=''">
            and donate_amount = #{donateAmount}
        </if>
        <if test="linkTel!=null and linkTel!=''">
            and link_tel = #{linkTel}
        </if>
        <if test="donateTime!=null and donateTime!=''">
            and donate_time = #{donateTime}
        </if>
        <if test="cardNo!=null and cardNo!=''">
            and card_no = #{cardNo}
        </if>
        <if test="usageDescribe!=null and usageDescribe!=''">
            and usage_describe = #{usageDescribe}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createName!=null and createName!=''">
            and create_name = #{createName}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        </where>
    </select>

</mapper>

