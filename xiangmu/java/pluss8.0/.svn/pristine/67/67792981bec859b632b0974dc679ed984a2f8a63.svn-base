<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.CommunityActiveCareRecordMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    institution_id,
    institution_name,
    care_type,
    care_mode,
    send_context,
    send_state,
    send_time,
    elder_ids,
    elder_names,
    tel_nums,
    amount,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    status,
    is_deleted,
    area_code,
    area_name
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.institutionId},
    #{item.institutionName},
    #{item.careType},
    #{item.careMode},
    #{item.sendContext},
    #{item.sendState},
    #{item.sendTime},
    #{item.elderIds},
    #{item.elderNames},
    #{item.telNums},
    #{item.amount},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.status},
    #{item.isDeleted},
    #{item.areaCode},
    #{item.areaName}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_community_active_care_record
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.CommunityActiveCareRecord">
        SELECT * from  tb_jiangyukeji_community_active_care_record
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
