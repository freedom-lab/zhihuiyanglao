<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.IotDeviceDataLogMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    tenant_name,
    big_device_type,
    type_id,
    device_name,
    device_serial,
    device_data_content,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status,
    corp_id,
    institution_id,
    institution_name
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.tenantName},
    #{item.bigDeviceType},
    #{item.typeId},
    #{item.deviceName},
    #{item.deviceSerial},
    #{item.deviceDataContent},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status},
    #{item.corpId},
    #{item.institutionId},
    #{item.institutionName}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_iot_device_data_log
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.IotDeviceDataLog">
        SELECT * from  tb_jiangyukeji_iot_device_data_log
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="tenantName!=null and tenantName!=''">
            and tenant_name = #{tenantName}
        </if>
        <if test="bigDeviceType!=null and bigDeviceType!=''">
            and big_device_type = #{bigDeviceType}
        </if>
        <if test="typeId!=null and typeId!=''">
            and type_id = #{typeId}
        </if>
        <if test="deviceName!=null and deviceName!=''">
            and device_name = #{deviceName}
        </if>
        <if test="deviceSerial!=null and deviceSerial!=''">
            and device_serial = #{deviceSerial}
        </if>
        <if test="deviceDataContent!=null and deviceDataContent!=''">
            and device_data_content = #{deviceDataContent}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        <if test="corpId!=null and corpId!=''">
            and corp_id = #{corpId}
        </if>
        <if test="institutionId!=null and institutionId!=''">
            and institution_id = #{institutionId}
        </if>
        <if test="institutionName!=null and institutionName!=''">
            and institution_name = #{institutionName}
        </if>
        </where>
        order by id desc limit #{pageSize} offset #{offset}
    </select>

    <select id="queryPageCount" parameterType="java.util.Map" resultType="java.lang.Integer">
        SELECT count(*) from tb_jiangyukeji_iot_device_data_log
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="tenantName!=null and tenantName!=''">
            and tenant_name = #{tenantName}
        </if>
        <if test="bigDeviceType!=null and bigDeviceType!=''">
            and big_device_type = #{bigDeviceType}
        </if>
        <if test="typeId!=null and typeId!=''">
            and type_id = #{typeId}
        </if>
        <if test="deviceName!=null and deviceName!=''">
            and device_name = #{deviceName}
        </if>
        <if test="deviceSerial!=null and deviceSerial!=''">
            and device_serial = #{deviceSerial}
        </if>
        <if test="deviceDataContent!=null and deviceDataContent!=''">
            and device_data_content = #{deviceDataContent}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        <if test="corpId!=null and corpId!=''">
            and corp_id = #{corpId}
        </if>
        <if test="institutionId!=null and institutionId!=''">
            and institution_id = #{institutionId}
        </if>
        <if test="institutionName!=null and institutionName!=''">
            and institution_name = #{institutionName}
        </if>
        </where>
    </select>

</mapper>

