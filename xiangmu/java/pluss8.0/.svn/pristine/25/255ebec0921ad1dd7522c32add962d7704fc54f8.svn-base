<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.HealthInterventionPlanMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    corp_name,
    institution_id,
    institution_name,
    plan_no,
    archive_id,
    elder_id,
