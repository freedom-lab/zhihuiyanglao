    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_health_intervention_plan
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

