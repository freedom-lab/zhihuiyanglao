<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.HealthFollowUpMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    corp_name,
    institution_id,
    institution_name,
    follow_up_no,
    archive_id,
    elder_id,
    elder_name,
    doctor_id,
    doctor_name,
    follow_up_date,
    follow_up_type,
    symptoms_signs,
    blood_pressure_sys,
    blood_pressure_dia,
    blood_sugar_fasting,
    blood_sugar_postprandial,
    heart_rate,
    weight,
    medication_adherence,
    plan_execution,
    existing_problems,
    treatment_advice,
    control_status,
    risk_level,
    next_follow_up_date,
    file_path,
    remark,
    create_user,
    create_name,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.corpName},
    #{item.institutionId},
    #{item.institutionName},
    #{item.followUpNo},
    #{item.archiveId},
    #{item.elderId},
    #{item.elderName},
    #{item.doctorId},
    #{item.doctorName},
    #{item.followUpDate},
    #{item.followUpType},
    #{item.symptomsSigns},
    #{item.bloodPressureSys},
    #{item.bloodPressureDia},
    #{item.bloodSugarFasting},
    #{item.bloodSugarPostprandial},
    #{item.heartRate},
    #{item.weight},
    #{item.medicationAdherence},
    #{item.planExecution},
    #{item.existingProblems},
    #{item.treatmentAdvice},
    #{item.controlStatus},
    #{item.riskLevel},
    #{item.nextFollowUpDate},
    #{item.filePath},
    #{item.remark},
    #{item.createUser},
    #{item.createName},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_health_follow_up
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.HealthFollowUp">
