<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.AssessmentPersonInfoMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    institution_id,
    institution_name,
    person_code,
    person_name,
    sex,
    age,
    link_tel,
    password,
    skill_level,
    document_type,
    id_card,
    special_ability,
    id_card_patha,
    id_card_pathb,
    nation,
    degree_education,
    duty_type,
    entry_date,
    dimission_date,
    photo,
    address,
    certificate_img,
    memo,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    server_state,
    is_deleted,
    status
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.institutionId},
    #{item.institutionName},
    #{item.personCode},
    #{item.personName},
    #{item.sex},
