<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.InsVegetableOrderInfoMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    corp_name,
    institution_id,
    institution_name,
    type_id,
    type_name,
    vegetable_name,
    purchase_name,
    purchase_amount,
    purchase_time,
    remark,
    create_user,
    create_name,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.corpName},
    #{item.institutionId},
    #{item.institutionName},
    #{item.typeId},
    #{item.typeName},
    #{item.vegetableName},
    #{item.purchaseName},
    #{item.purchaseAmount},
    #{item.purchaseTime},
    #{item.remark},
    #{item.createUser},
    #{item.createName},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_ins_vegetable_order_info
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.InsVegetableOrderInfo">
        SELECT * from  tb_jiangyukeji_ins_vegetable_order_info
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="corpId!=null and corpId!=''">
            and corp_id = #{corpId}
