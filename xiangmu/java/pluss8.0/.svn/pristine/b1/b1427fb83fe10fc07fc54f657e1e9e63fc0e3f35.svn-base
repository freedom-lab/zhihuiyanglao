package cn.pluss.platform.model.auth;

import  java.util.Date;
import org.springframework.format.annotation.DateTimeFormat;

public class UserSub {

    private Integer id;
    private String subUserCode;
    private String subUserName;
    private String subLoginName;
    private String password;
    private String subSystemCode;
    private String subSystemName;
    @DateTimeFormat(pattern="yyyy-MM-dd hh:mm:ss")
    private Date createDt;

    public Integer getId() {
        return id;
    }
    public void setId(Integer id) {
         this.id = id;
    }
    public String getSubUserCode() {
        return subUserCode;
    }
    public void setSubUserCode(String subUserCode) {
         this.subUserCode = subUserCode;
    }
    public String getSubUserName() {
        return subUserName;
    }
    public void setSubUserName(String subUserName) {
         this.subUserName = subUserName;
    }
    public String getSubLoginName() {
        return subLoginName;
    }
    public void setSubLoginName(String subLoginName) {
         this.subLoginName = subLoginName;
    }
    public String getPassword() {
        return password;
    }
    public void setPassword(String password) {
         this.password = password;
    }
    public String getSubSystemCode() {
        return subSystemCode;
    }
    public void setSubSystemCode(String subSystemCode) {
         this.subSystemCode = subSystemCode;
    }
    public String getSubSystemName() {
        return subSystemName;
    }
    public void setSubSystemName(String subSystemName) {
         this.subSystemName = subSystemName;
    }
    public Date getCreateDt() {
        return createDt;
    }
    public void setCreateDt(Date createDt) {
         this.createDt = createDt;
    }
}

