import org.apache.ibatis.annotations.Mapper;

import java.util.List;
import java.util.Map;
import ${packageName}.model.entity.${beanName};

public interface ${beanName}Mapper extends BaseMapper<${beanName}>{
    /**
    * 分页查询
    * @param map
    * @return
    */
