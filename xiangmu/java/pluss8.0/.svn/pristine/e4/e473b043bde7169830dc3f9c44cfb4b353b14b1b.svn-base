<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.AssessmentInstitutionInfoMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    institution_code,
    institution_img,
    license_img,
    institution_name,
    credit_code,
    legal_man,
    legal_link_tel,
    id_card,
    manager,
    link_tel,
    establish_date,
    registrar,
    business_area,
    address,
    username,
    password,
    institution_brief,
    institution_status,
    area_code,
    area_name,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status,
    institution_type,
    manage_level
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.institutionCode},
    #{item.institutionImg},
    #{item.licenseImg},
    #{item.institutionName},
    #{item.creditCode},
    #{item.legalMan},
    #{item.legalLinkTel},
    #{item.idCard},
    #{item.manager},
    #{item.linkTel},
    #{item.establishDate},
    #{item.registrar},
    #{item.businessArea},
    #{item.address},
    #{item.username},
    #{item.password},
    #{item.institutionBrief},
    #{item.institutionStatus},
    #{item.areaCode},
    #{item.areaName},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status},
    #{item.institutionType},
    #{item.manageLevel}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_assessment_institution_info
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.AssessmentInstitutionInfo">
        SELECT * from  tb_jiangyukeji_assessment_institution_info
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="institutionCode!=null and institutionCode!=''">
