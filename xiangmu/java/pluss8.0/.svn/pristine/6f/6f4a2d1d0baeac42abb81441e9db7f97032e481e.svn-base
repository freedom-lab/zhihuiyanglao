package cn.pluss.platform.model.auth;

import  java.util.Date;
import org.springframework.format.annotation.DateTimeFormat;

public class PortalConfig {

    private Integer id;
    private String draft;
    private String content;
    @DateTimeFormat(pattern="yyyy-MM-dd hh:mm:ss")
    private Date createDt;
    @DateTimeFormat(pattern="yyyy-MM-dd hh:mm:ss")
    private Date releaseDt;
    @DateTimeFormat(pattern="yyyy-MM-dd hh:mm:ss")
    private Date updateDt;
    private String updateor;
    private String conserve;

    public Integer getId() {
        return id;
    }
    public void setId(Integer id) {
         this.id = id;
    }
    public String getDraft() {
        return draft;
    }
    public void setDraft(String draft) {
         this.draft = draft;
    }
    public String getContent() {
        return content;
    }
    public void setContent(String content) {
         this.content = content;
    }
    public Date getCreateDt() {
        return createDt;
    }
    public void setCreateDt(Date createDt) {
         this.createDt = createDt;
    }
    public Date getReleaseDt() {
        return releaseDt;
    }
    public void setReleaseDt(Date releaseDt) {
         this.releaseDt = releaseDt;
    }
    public Date getUpdateDt() {
        return updateDt;
    }
    public void setUpdateDt(Date updateDt) {
         this.updateDt = updateDt;
    }
    public String getUpdateor() {
        return updateor;
    }
    public void setUpdateor(String updateor) {
         this.updateor = updateor;
    }
	public String getConserve() {
		return conserve;
	}
	public void setConserve(String conserve) {
		this.conserve = conserve;
	}
    
}

