<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.IotDeviceTypeMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    trans_mode,
    big_device_type,
    interface_method,
    interface_url,
    type_name,
    manufacturer,
    use_range,
    host_state,
    param_desp,
    device_img,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.transMode},
    #{item.bigDeviceType},
    #{item.interfaceMethod},
    #{item.interfaceUrl},
    #{item.typeName},
    #{item.manufacturer},
    #{item.useRange},
    #{item.hostState},
    #{item.paramDesp},
    #{item.deviceImg},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_iot_device_type
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.IotDeviceType">
        SELECT * from  tb_jiangyukeji_iot_device_type
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="transMode!=null and transMode!=''">
            and trans_mode = #{transMode}
        </if>
        <if test="bigDeviceType!=null and bigDeviceType!=''">
            and big_device_type = #{bigDeviceType}
        </if>
        <if test="interfaceMethod!=null and interfaceMethod!=''">
            and interface_method = #{interfaceMethod}
        </if>
        <if test="interfaceUrl!=null and interfaceUrl!=''">
            and interface_url = #{interfaceUrl}
        </if>
        <if test="typeName!=null and typeName!=''">
            and type_name = #{typeName}
        </if>
        <if test="manufacturer!=null and manufacturer!=''">
            and manufacturer = #{manufacturer}
        </if>
        <if test="useRange!=null and useRange!=''">
            and use_range = #{useRange}
        </if>
        <if test="hostState!=null and hostState!=''">
            and host_state = #{hostState}
        </if>
        <if test="paramDesp!=null and paramDesp!=''">
            and param_desp = #{paramDesp}
        </if>
        <if test="deviceImg!=null and deviceImg!=''">
            and device_img = #{deviceImg}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        </where>
        order by id desc limit #{pageSize} offset #{offset}
    </select>

    <select id="queryPageCount" parameterType="java.util.Map" resultType="java.lang.Integer">
        SELECT count(*) from tb_jiangyukeji_iot_device_type
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="transMode!=null and transMode!=''">
            and trans_mode = #{transMode}
        </if>
        <if test="bigDeviceType!=null and bigDeviceType!=''">
            and big_device_type = #{bigDeviceType}
        </if>
        <if test="interfaceMethod!=null and interfaceMethod!=''">
            and interface_method = #{interfaceMethod}
        </if>
        <if test="interfaceUrl!=null and interfaceUrl!=''">
            and interface_url = #{interfaceUrl}
        </if>
        <if test="typeName!=null and typeName!=''">
            and type_name = #{typeName}
        </if>
        <if test="manufacturer!=null and manufacturer!=''">
            and manufacturer = #{manufacturer}
        </if>
        <if test="useRange!=null and useRange!=''">
            and use_range = #{useRange}
        </if>
        <if test="hostState!=null and hostState!=''">
            and host_state = #{hostState}
        </if>
        <if test="paramDesp!=null and paramDesp!=''">
            and param_desp = #{paramDesp}
        </if>
        <if test="deviceImg!=null and deviceImg!=''">
            and device_img = #{deviceImg}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        </where>
    </select>

</mapper>

