<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.BladeDictMapper">
    <sql id="tableFieldNames">
    (
    id,
    parent_id,
    code,
    dict_key,
    dict_value,
    sort,
    remark,
    is_sealed,
    is_deleted
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.parentId},
    #{item.code},
    #{item.dictKey},
    #{item.dictValue},
    #{item.sort},
    #{item.remark},
    #{item.isSealed},
    #{item.isDeleted}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_blade_dict
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.BladeDict">
        SELECT * from  tb_jiangyukeji_blade_dict
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="parentId!=null and parentId!=''">
            and parent_id = #{parentId}
        </if>
        <if test="code!=null and code!=''">
            and code = #{code}
        </if>
        <if test="dictKey!=null and dictKey!=''">
            and dict_key = #{dictKey}
        </if>
        <if test="dictValue!=null and dictValue!=''">
            and dict_value = #{dictValue}
        </if>
        <if test="sort!=null and sort!=''">
            and sort = #{sort}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="isSealed!=null and isSealed!=''">
            and is_sealed = #{isSealed}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        </where>
        order by id desc limit #{pageSize} offset #{offset}
    </select>

    <select id="queryPageCount" parameterType="java.util.Map" resultType="java.lang.Integer">
        SELECT count(*) from tb_jiangyukeji_blade_dict
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="parentId!=null and parentId!=''">
            and parent_id = #{parentId}
        </if>
        <if test="code!=null and code!=''">
            and code = #{code}
        </if>
        <if test="dictKey!=null and dictKey!=''">
            and dict_key = #{dictKey}
        </if>
        <if test="dictValue!=null and dictValue!=''">
            and dict_value = #{dictValue}
        </if>
        <if test="sort!=null and sort!=''">
            and sort = #{sort}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="isSealed!=null and isSealed!=''">
            and is_sealed = #{isSealed}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        </where>
    </select>

</mapper>

