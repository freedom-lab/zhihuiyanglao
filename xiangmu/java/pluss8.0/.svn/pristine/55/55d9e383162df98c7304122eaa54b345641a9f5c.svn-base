<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.SmartDeviceParamBedMapper">
    <sql id="tableFieldNames">
        (
            id, tenant_id,
            grant_id,
            device_name,
            device_serial,
            hr_alarm_enable,
            hr_alarm_max,
            hr_alarm_min,
            rr_alarm_enable,
            rr_stop_enable,
            rr_alarm_max,
            rr_alarm_min,
            off_bed_enable,
            leave_dura,
            sleep_day_dura_start,
            sleep_day_dura_stop,
            sleep_all_day_enable,
            sleep_night_dura_start,
            sleep_night_dura_stop,
            noon_sleep_day_enable,
            night_sleeps_day_enable,
            remark,
            create_user,
            create_dept,
            create_time,
            update_user,
            update_time,
            is_deleted,
            heartRate,
            breathRate,
            bodyShake,
            onBed,
            status)
    </sql>
    <sql id="tableFiledUpcaseNames">
        (
            #{item.id}, #{item.tenantId},
            #{item.grantId},
            #{item.deviceName},
            #{item.deviceSerial},
            #{item.hrAlarmEnable},
            #{item.hrAlarmMax},
            #{item.hrAlarmMin},
            #{item.rrAlarmEnable},
            #{item.rrStopEnable},
            #{item.rrAlarmMax},
            #{item.rrAlarmMin},
            #{item.offBedEnable},
            #{item.leaveDura},
            #{item.sleepDayDuraStart},
            #{item.sleepDayDuraStop},
            #{item.sleepAllDayEnable},
            #{item.sleepNightDuraStart},
            #{item.sleepNightDuraStop},
            #{item.noonSleepDayEnable},
            #{item.nightSleepsDayEnable},
            #{item.remark},
            #{item.createUser},
            #{item.createDept},
            #{item.createTime},
            #{item.updateUser},
            #{item.updateTime},
            #{item.isDeleted},
            #{item.heartRate},
            #{item.breathRate},
            #{item.bodyShake},
            #{item.onBed},
            #{item.status})
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_smart_device_param_bed
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>
    <update id="updateSmartDeviceParamBed" parameterType="cn.pluss.platform.model.entity.SmartDeviceParamBed">
        UPDATE tb_jiangyukeji_smart_device_param_bed
        <set>
            <if test="heartRate != null">heart_rate = #{heartRate},</if>
            <if test="breathRate != null">breath_rate = #{breathRate},</if>
            <if test="bodyShake != null">body_shake = #{bodyShake},</if>
            <if test="onBed != null">on_bed = #{onBed},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE device_name = #{deviceName}
    </update>

    <select id="queryPage" parameterType="java.util.Map"
            resultType="cn.pluss.platform.model.entity.SmartDeviceParamBed">
        SELECT * from tb_jiangyukeji_smart_device_param_bed
        <where>
            <if test="id!=null and id!=''">
                and id = #{id}
            </if>
