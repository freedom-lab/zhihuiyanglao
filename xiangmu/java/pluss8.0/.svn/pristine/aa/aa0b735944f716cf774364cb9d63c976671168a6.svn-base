<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.MemberConsumeLogMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    institution_id,
    institution_name,
    serial_number,
    elder_id,
    elder_name,
    sex,
    age,
    id_card,
    link_tel,
    member_card,
    member_level,
    consume_name,
    consume_type,
    consume_amount,
    integral,
    pay_type,
    pay_state,
    consume_state,
    consume_time,
    create_name,
    area_code,
    area_name,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    status,
    is_deleted,
    data_source,
    is_readly
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.institutionId},
    #{item.institutionName},
    #{item.serialNumber},
    #{item.elderId},
