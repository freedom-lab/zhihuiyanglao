    #{item.memberLevel},
    #{item.consumeName},
    #{item.consumeType},
    #{item.consumeAmount},
    #{item.integral},
    #{item.payType},
    #{item.payState},
    #{item.consumeState},
    #{item.consumeTime},
    #{item.createName},
    #{item.areaCode},
    #{item.areaName},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.status},
    #{item.isDeleted},
    #{item.dataSource},
    #{item.isReadly}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_member_consume_log
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

