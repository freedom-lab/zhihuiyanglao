package cn.pluss.platform.model.vo;

import com.alibaba.fastjson.annotation.JSONField;
import com.fasterxml.jackson.annotation.JsonProperty;
import lombok.Data;

@Data
public class VitalSignsDataEvent {
    @JsonProperty("client_id")
    @JSONField(name = "client_id")
    private String clientId;

    @JsonProperty("version")
    @JSONField(name = "version")
    private String version;

    @JsonProperty("timestamp")
    @JSONField(name = "timestamp")
    private String timestamp;

    @JsonProperty("sign")
    @JSONField(name = "sign")
    private String sign;

    @JsonProperty("sign_version")
    @JSONField(name = "sign_version")
    private String signVersion;

    @JsonProperty("sign_nonce")
    @JSONField(name = "sign_nonce")
    private String signNonce;

    @JsonProperty("sign_method")
    @JSONField(name = "sign_method")
    private String signMethod;

    @JsonProperty("message_id")
    @JSONField(name = "message_id")
    private String messageId;

    @JsonProperty("product_id")
    @JSONField(name = "product_id")
    private String productId;

    @JsonProperty("device_id")
    @JSONField(name = "device_id")
    private String deviceId;

    @JsonProperty("device_name")
    @JSONField(name = "device_name")
    private String deviceName;

    @JsonProperty("home_id")
    @JSONField(name = "home_id")
    private String homeId;

    @JsonProperty("type")
    @JSONField(name = "type")
    private String type;

    @JsonProperty("data")
    @JSONField(name = "data")
    private VitalSignsData data;
}
