<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.HealthMedicineRecordsMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    institution_id,
    institution_name,
    elder_id,
    elder_name,
    id_card,
    drug_name,
    use_type,
    drug_frequency_unit,
    drug_frequency,
    drug_dosage,
    drug_unit,
    drug_remark,
    start_date,
    end_date,
    compliance,
    effect_desp,
    record_name,
    record_datetime,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status,
    area_code,
    area_name
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.institutionId},
    #{item.institutionName},
    #{item.elderId},
    #{item.elderName},
    #{item.idCard},
    #{item.drugName},
    #{item.useType},
    #{item.drugFrequencyUnit},
    #{item.drugFrequency},
    #{item.drugDosage},
    #{item.drugUnit},
    #{item.drugRemark},
    #{item.startDate},
    #{item.endDate},
    #{item.compliance},
    #{item.effectDesp},
    #{item.recordName},
    #{item.recordDatetime},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status},
    #{item.areaCode},
    #{item.areaName}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_health_medicine_records
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.HealthMedicineRecords">
        SELECT * from  tb_jiangyukeji_health_medicine_records
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="corpId!=null and corpId!=''">
