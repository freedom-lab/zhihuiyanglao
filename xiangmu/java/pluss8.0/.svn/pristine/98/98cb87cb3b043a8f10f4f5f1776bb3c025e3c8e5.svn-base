    #{item.tip},
    #{item.opinion},
    #{item.warnFlag},
    #{item.areaCode},
    #{item.areaName},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status},
    #{item.dataSource}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_health_arteriosclerosis
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

