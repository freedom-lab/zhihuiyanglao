<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.HealthArteriosclerosisMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    institution_id,
    institution_name,
    elder_id,
    elder_name,
    id_card,
    sex,
    age,
    gauge_time,
    gauge_type,
    heightPressure,
    lowPressure,
    pulse,
