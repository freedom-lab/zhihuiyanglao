    cAPP,
    addTime,
    tip,
    opinion,
    warn_flag,
    area_code,
    area_name,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status,
    data_source
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.institutionId},
    #{item.institutionName},
    #{item.elderId},
    #{item.elderName},
