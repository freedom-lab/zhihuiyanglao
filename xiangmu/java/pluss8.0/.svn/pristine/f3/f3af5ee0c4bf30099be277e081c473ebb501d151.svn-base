<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.CareAccidentRecordMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    institution_id,
    institution_name,
    elder_id,
    elder_name,
    accident_type,
    occur_date,
    place,
    explain_text,
    server_id,
    server_name,
    result,
    area_code,
    area_name,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    status,
    is_deleted
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.institutionId},
    #{item.institutionName},
    #{item.elderId},
    #{item.elderName},
    #{item.accidentType},
    #{item.occurDate},
    #{item.place},
    #{item.explainText},
    #{item.serverId},
    #{item.serverName},
    #{item.result},
    #{item.areaCode},
    #{item.areaName},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.status},
    #{item.isDeleted}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_care_accident_record
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.CareAccidentRecord">
        SELECT * from  tb_jiangyukeji_care_accident_record
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
