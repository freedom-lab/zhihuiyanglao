package cn.pluss.platform.controller;

import cn.pluss.platform.api.PageInfo;
import cn.pluss.platform.api.PageQueryInfo;
import cn.pluss.platform.api.Result;
import cn.pluss.platform.api.ResultGenerator;
import cn.pluss.platform.constants.ProjectConstant;
import cn.pluss.platform.model.entity.CareNursingLevelSetting;
import cn.pluss.platform.service.careNursingLevelSetting.CareNursingLevelSettingService;
import cn.pluss.platform.util.StringUtil;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.apache.log4j.Logger;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.HashMap;
import java.util.List;
import java.util.Map;
import javax.annotation.Resource;



@RestController
@RequestMapping("/careNursingLevelSetting")
@Api(value = "CareNursingLevelSetting控制类",tags={"CareNursingLevelSetting接口"})
public class CareNursingLevelSettingController{
    private Logger logger = Logger.getLogger(this.getClass());

    @Resource
    private CareNursingLevelSettingService careNursingLevelSettingService;

    /**
    * 分页查询
    *
    * @param pageQueryInfo 分页查询
    * @return 查询结果
    */
    @PostMapping("/list")
    @ApiOperation(value = "分页查询",notes = "返回分页过后的数据",httpMethod = "POST")
    public Result<PageInfo<CareNursingLevelSetting>> list(@RequestBody PageQueryInfo pageQueryInfo) {
        if(pageQueryInfo.getPageSize()==0) {
            pageQueryInfo.setPageSize(ProjectConstant.PAGE_SIZE);
        }
        if(pageQueryInfo.getCurrPage()==0) {
            pageQueryInfo.setCurrPage(1);
        }
        Map<String,Object> map=new HashMap<String, Object>();
        map.put("pageSize",pageQueryInfo.getPageSize());
        map.put("offset", (pageQueryInfo.getCurrPage()-1)*pageQueryInfo.getPageSize());
        if(pageQueryInfo.getCondition() != null){
            map.putAll(pageQueryInfo.getCondition());
        }
        List<CareNursingLevelSetting> careNursingLevelSettingList = careNursingLevelSettingService.queryPage(map);
        Integer count= careNursingLevelSettingService.queryPageCount(map);
        //返回参数
        PageInfo pager=new PageInfo<CareNursingLevelSetting>(count, StringUtil.getPageCount(count,pageQueryInfo.getPageSize()), pageQueryInfo.getCurrPage(), pageQueryInfo.getPageSize(), careNursingLevelSettingList);
        return ResultGenerator.genSuccessResult(pager);
    }

    /**
    * 根据条件获取集合
    * @param careNursingLevelSetting
    * @return
    */
    @PostMapping("/queryList")
    @ApiOperation(value = "根据条件获取集合", notes = "查看多个项目的内容", httpMethod = "POST")
    public Result<List<CareNursingLevelSetting>> queryList(@RequestBody CareNursingLevelSetting careNursingLevelSetting) {
        List<CareNursingLevelSetting> careNursingLevelSettingList = careNursingLevelSettingService.queryList(careNursingLevelSetting);
        return ResultGenerator.genSuccessResult(careNursingLevelSettingList);
    }

    /**
    * 通过ID查询单条数据
    *
    * @param careNursingLevelSetting 对象
    * @return 实例对象
    */
    @PostMapping("/queryOne")
    @ApiOperation("通过ID查询单条数据")
    public Result<CareNursingLevelSetting> queryOne(@RequestBody CareNursingLevelSetting careNursingLevelSetting) {
        return ResultGenerator.genSuccessResult(careNursingLevelSettingService.queryOne(careNursingLevelSetting));
    }

    /**
    * 保存数据
    * @param careNursingLevelSetting
    * @return
    */
    @PostMapping("/save")
    @ApiOperation(value = "保存数据", notes = "保存数据", httpMethod = "POST")
    public Result save(@RequestBody CareNursingLevelSetting careNursingLevelSetting) {
        //Date currentDt = new Date();
        if (careNursingLevelSetting.getId() != null && careNursingLevelSetting.getId().longValue() > 0) {
            //careNursingLevelSetting.setUpdatedDt(currentDt);
            careNursingLevelSettingService.update(careNursingLevelSetting);
        } else {
            //careNursingLevelSetting.setCreatedDt(currentDt);
            //careNursingLevelSetting.setUpdatedDt(currentDt);
            careNursingLevelSettingService.insert(careNursingLevelSetting);
        }
        return ResultGenerator.genSuccessResult();
    }

    /**
    * 新增数据
    *
    * @param careNursingLevelSetting 实例对象
    * @return 实例对象
    */
    @PostMapping("/add")
    @ApiOperation(value = "添加数据", notes = "添加新的数据", httpMethod = "POST")
    public Result<CareNursingLevelSetting> add(@RequestBody CareNursingLevelSetting careNursingLevelSetting) {
        //Date currentDt = new Date();
        //careNursingLevelSetting.setCreatedDt(currentDt);
        //careNursingLevelSetting.setUpdatedDt(currentDt);
        return ResultGenerator.genSuccessResult(careNursingLevelSettingService.insert(careNursingLevelSetting));
    }

    /**
    * 更新数据
    *
    * @param careNursingLevelSetting 实例对象
    * @return 实例对象
    */
    @PostMapping("/update")
    @ApiOperation(value = "更新数据", notes = "根据内容更新数据", httpMethod = "POST")
    public Result<CareNursingLevelSetting> update(@RequestBody CareNursingLevelSetting careNursingLevelSetting) {
        return ResultGenerator.genSuccessResult(careNursingLevelSettingService.update(careNursingLevelSetting));
    }

    /**
    * 通过主键删除数据
    *
    * @param careNursingLevelSetting 主键
    * @return 是否成功
    */
    @PostMapping("/delete")
    @ApiOperation(value = "删除数据", notes = "根据id删除数据", httpMethod = "POST")
    public Result<Boolean> deleteById(@RequestBody CareNursingLevelSetting careNursingLevelSetting) {
        return ResultGenerator.genSuccessResult(careNursingLevelSettingService.deleteById(careNursingLevelSetting.getId()));
    }

    /**
    * 批量新增
    *
    * @param insertList 主键
    * @return 是否成功
    */
    @PostMapping("/saveBatch")
    @ApiOperation(value = "批量新增", notes = "批量新增", httpMethod = "POST")
    public Result<Boolean> saveBatch(@RequestBody List<CareNursingLevelSetting> insertList) {
        return ResultGenerator.genSuccessResult(careNursingLevelSettingService.saveCareNursingLevelSettingBatch(insertList));
    }

}


