    #{item.sellingAmount},
    #{item.remark},
    #{item.createUser},
    #{item.createName},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_ins_logistics_inventory_info
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

