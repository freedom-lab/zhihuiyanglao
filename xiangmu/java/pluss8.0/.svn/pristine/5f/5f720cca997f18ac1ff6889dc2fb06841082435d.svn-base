package cn.pluss.platform.model.coding;

public class TableBean {
    private String beanName;
    private String beanNameSmall;

    public String getBeanName() {
        return beanName;
    }

    public void setBeanName(String beanName) {
        this.beanName = beanName;
    }

    public String getBeanNameSmall() {
        return beanNameSmall;
    }

    public void setBeanNameSmall(String beanNameSmall) {
        this.beanNameSmall = beanNameSmall;
    }
}
