        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="readState!=null and readState!=''">
            and read_state = #{readState}
        </if>
        <if test="readTime!=null and readTime!=''">
            and read_time = #{readTime}
        </if>
        </where>
        order by id desc limit #{pageSize} offset #{offset}
    </select>

    <select id="queryPageCount" parameterType="java.util.Map" resultType="java.lang.Integer">
        SELECT count(*) from tb_jiangyukeji_community_medication_detail
        <where>
