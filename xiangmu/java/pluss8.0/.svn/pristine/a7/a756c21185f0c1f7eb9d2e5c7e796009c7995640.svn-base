        </if>
        <if test="institutionName!=null and institutionName!=''">
            and institution_name = #{institutionName}
        </if>
        <if test="elderId!=null and elderId!=''">
            and elder_id = #{elderId}
        </if>
        <if test="elderName!=null and elderName!=''">
            and elder_name = #{elderName}
        </if>
        <if test="medicationId!=null and medicationId!=''">
            and medication_id = #{medicationId}
        </if>
        <if test="medicationName!=null and medicationName!=''">
            and medication_name = #{medicationName}
        </if>
        <if test="remindDate!=null and remindDate!=''">
