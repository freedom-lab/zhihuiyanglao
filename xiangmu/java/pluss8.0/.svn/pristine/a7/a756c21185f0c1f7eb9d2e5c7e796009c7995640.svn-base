<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.CommunityMedicationDetailMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    institution_id,
    institution_name,
    elder_id,
    elder_name,
    medication_id,
    medication_name,
    remind_date,
    medication_time,
    send_context,
    send_state,
    area_code,
    area_name,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    status,
    is_deleted,
    read_state,
    read_time
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.institutionId},
    #{item.institutionName},
    #{item.elderId},
    #{item.elderName},
    #{item.medicationId},
    #{item.medicationName},
    #{item.remindDate},
    #{item.medicationTime},
    #{item.sendContext},
    #{item.sendState},
    #{item.areaCode},
    #{item.areaName},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.status},
    #{item.isDeleted},
    #{item.readState},
    #{item.readTime}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_community_medication_detail
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.CommunityMedicationDetail">
        SELECT * from  tb_jiangyukeji_community_medication_detail
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="corpId!=null and corpId!=''">
            and corp_id = #{corpId}
        </if>
        <if test="institutionId!=null and institutionId!=''">
