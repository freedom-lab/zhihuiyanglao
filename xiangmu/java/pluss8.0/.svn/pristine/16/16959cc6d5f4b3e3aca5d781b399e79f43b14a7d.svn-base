<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.MarketUserCollectionMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    goods_id,
    elder_id,
    collect_time,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    status,
    is_deleted
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.goodsId},
    #{item.elderId},
    #{item.collectTime},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.status},
    #{item.isDeleted}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_market_user_collection
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.MarketUserCollection">
        SELECT * from  tb_jiangyukeji_market_user_collection
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="goodsId!=null and goodsId!=''">
            and goods_id = #{goodsId}
        </if>
        <if test="elderId!=null and elderId!=''">
            and elder_id = #{elderId}
        </if>
        <if test="collectTime!=null and collectTime!=''">
            and collect_time = #{collectTime}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        </where>
        order by id desc limit #{pageSize} offset #{offset}
    </select>

    <select id="queryPageCount" parameterType="java.util.Map" resultType="java.lang.Integer">
        SELECT count(*) from tb_jiangyukeji_market_user_collection
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="goodsId!=null and goodsId!=''">
            and goods_id = #{goodsId}
        </if>
        <if test="elderId!=null and elderId!=''">
            and elder_id = #{elderId}
        </if>
        <if test="collectTime!=null and collectTime!=''">
            and collect_time = #{collectTime}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        </where>
    </select>

</mapper>

