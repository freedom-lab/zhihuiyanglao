<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.InsDonateGrantDetailMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    corp_id,
    corp_name,
    institution_id,
    institution_name,
    donate_id,
    detail_id,
    grant_time,
    grant_name,
    grant_num,
    grant_money,
    grant_describe,
    recipient_name,
    remark,
    create_user,
    create_name,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.corpName},
    #{item.institutionId},
    #{item.institutionName},
    #{item.donateId},
    #{item.detailId},
    #{item.grantTime},
    #{item.grantName},
    #{item.grantNum},
    #{item.grantMoney},
    #{item.grantDescribe},
    #{item.recipientName},
    #{item.remark},
    #{item.createUser},
    #{item.createName},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_ins_donate_grant_detail
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.InsDonateGrantDetail">
        SELECT * from  tb_jiangyukeji_ins_donate_grant_detail
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="corpId!=null and corpId!=''">
            and corp_id = #{corpId}
        </if>
        <if test="corpName!=null and corpName!=''">
            and corp_name = #{corpName}
        </if>
        <if test="institutionId!=null and institutionId!=''">
            and institution_id = #{institutionId}
        </if>
        <if test="institutionName!=null and institutionName!=''">
            and institution_name = #{institutionName}
        </if>
        <if test="donateId!=null and donateId!=''">
            and donate_id = #{donateId}
        </if>
        <if test="detailId!=null and detailId!=''">
