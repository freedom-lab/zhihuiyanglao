package cn.pluss.platform.model.coding;

import  java.util.Date;
import java.util.List;

import org.springframework.format.annotation.DateTimeFormat;

public class Table {

     private  Integer id;
     private String tableName;
     private String tableComment;
     private String tableType;
     private String keyPolicy;
     private String isPage;
     private String isTree;
     private String beanNameRule;
     private String beanNameReduce;
     private  String keyColumn;
    private Boolean autoIncrement;
    private Boolean oldKeyAutoIncrement;
     private String originalTableName;
     private List<TableColumn> tableColumnList;
    private  Integer seq;
    private TableColumn currKeyColumn;
    private TableColumn oldKeyColumn;
    @DateTimeFormat(pattern="yyyy-MM-dd hh:mm:ss")
    private Date createDt;
    private String status;
    private String versionCode;

    private String tableCode;
    public  Integer getId() {
        return id;
    }
    public void setId(Integer id) {
     this.id = id;
    }
    public  String getTableName() {
        return tableName;
    }
    public void setTableName(String tableName) {
     this.tableName = tableName;
    }
    public  String getTableComment() {
        return tableComment;
    }
    public void setTableComment(String tableComment) {
     this.tableComment = tableComment;
    }
    public  String getTableType() {
        return tableType;
    }
    public void setTableType(String tableType) {
     this.tableType = tableType;
    }
    public  String getKeyPolicy() {
        return keyPolicy;
    }
    public void setKeyPolicy(String keyPolicy) {
     this.keyPolicy = keyPolicy;
    }
    public  String getIsPage() {
        return isPage;
    }
    public void setIsPage(String isPage) {
     this.isPage = isPage;
    }
    public  String getIsTree() {
        return isTree;
    }
    public void setIsTree(String isTree) {
     this.isTree = isTree;
    }
    public  String getBeanNameRule() {
        return beanNameRule;
    }
    public void setBeanNameRule(String beanNameRule) {
     this.beanNameRule = beanNameRule;
    }
    public  String getBeanNameReduce() {
        return beanNameReduce;
    }
    public void setBeanNameReduce(String beanNameReduce) {
     this.beanNameReduce = beanNameReduce;
    }

    public List<TableColumn> getTableColumnList() {
        return tableColumnList;
    }

    public void setTableColumnList(List<TableColumn> tableColumnList) {
        this.tableColumnList = tableColumnList;
    }

    public Date getCreateDt() {
        return createDt;
    }

    public void setCreateDt(Date createDt) {
        this.createDt = createDt;
    }

    public String getStatus() {
        return status;
    }

    public void setStatus(String status) {
        this.status = status;
    }

    public String getVersionCode() {
        return versionCode;
    }

    public void setVersionCode(String versionCode) {
        this.versionCode = versionCode;
    }

    public String getTableCode() {
        return tableCode;
    }

    public void setTableCode(String tableCode) {
        this.tableCode = tableCode;
    }

    public String getKeyColumn() {
        return keyColumn;
    }

    public void setKeyColumn(String keyColumn) {
        this.keyColumn = keyColumn;
    }

    public String getOriginalTableName() {
        return originalTableName;
    }

    public void setOriginalTableName(String originalTableName) {
        this.originalTableName = originalTableName;
    }

    public Integer getSeq() {
        return seq;
    }

    public void setSeq(Integer seq) {
        this.seq = seq;
    }


    public Boolean getAutoIncrement() {
        return autoIncrement;
    }

    public void setAutoIncrement(Boolean autoIncrement) {
        this.autoIncrement = autoIncrement;
    }

    public Boolean getOldKeyAutoIncrement() {
        return oldKeyAutoIncrement;
    }

    public void setOldKeyAutoIncrement(Boolean oldKeyAutoIncrement) {
        this.oldKeyAutoIncrement = oldKeyAutoIncrement;
    }



    public void setCurrKeyColumn(TableColumn currKeyColumn) {
        this.currKeyColumn = currKeyColumn;
    }

    public TableColumn getCurrKeyColumn() {
        return currKeyColumn;
    }

    public TableColumn getOldKeyColumn() {
        return oldKeyColumn;
    }

    public void setOldKeyColumn(TableColumn oldKeyColumn) {
        this.oldKeyColumn = oldKeyColumn;
    }
}


