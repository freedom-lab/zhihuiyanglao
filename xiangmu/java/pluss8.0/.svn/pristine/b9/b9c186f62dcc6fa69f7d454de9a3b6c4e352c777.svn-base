    create_user,
    create_name,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.corpId},
    #{item.corpName},
    #{item.institutionId},
    #{item.institutionName},
    #{item.roomName},
