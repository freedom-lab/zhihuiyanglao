    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_ins_activity_room_info
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.InsActivityRoomInfo">
