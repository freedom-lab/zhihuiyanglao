				 <if test="tableCode!= null  and tableCode!='' ">
				 tableCode= #{tableCode},
				 </if>
				 <if test="seq!= null  and seq!='' ">
				 seq= #{seq},
				 </if>
                  <if test="tableColumnCode!= null and tableColumnCode!='' ">
                  tableColumnCode = #{tableColumnCode},
                 </if>
                <if test="preColumn!= null and preColumn!='' ">
                      preColumn = #{preColumn}
                </if>
        </set>
        where id=#{id}
    </update>

    <delete id="deleteTableColumn" parameterType="cn.pluss.platform.model.coding.TableColumn" >
