                <if test="isKey!= null and isKey!='' ">
                    and  isKey = #{ isKey}
                </if>
                <if test="isNotNull!= null and isNotNull!='' ">
                    and  isNotNull = #{ isNotNull}
                </if>
                <if test="autoIncrement!= null and autoIncrement!='' ">
