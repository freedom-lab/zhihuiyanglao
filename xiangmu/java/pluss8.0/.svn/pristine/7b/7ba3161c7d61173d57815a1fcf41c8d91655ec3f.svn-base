    <update id="updateTableColumn" parameterType="cn.pluss.platform.model.coding.TableColumn" >
        update tb_yunlankeji_table_column
        <set>
				 <if test="id!= null  and id!='' ">
				 id= #{id},
				 </if>
				 <if test="tableName!= null  and tableName!='' ">
