<mapper namespace="cn.pluss.platform.mapper.base.coding.TableColumnMapper">

    <insert id="saveTableColumn" parameterType="cn.pluss.platform.model.coding.TableColumn">
		<selectKey keyProperty="id" order="AFTER" resultType="java.lang.Integer">
            select LAST_INSERT_ID()
        </selectKey>
        insert into tb_yunlankeji_table_column(id,tableName,columnName,columnDesc,columnLength,defaultValue,columnType,isKey,isNotNull,autoIncrement,tableCode,seq,tableColumnCode,preColumn)VALUES(#{id},#{tableName},#{columnName},#{columnDesc},#{columnLength},#{defaultValue},#{columnType},#{isKey},#{isNotNull},#{autoIncrement},#{tableCode},#{seq},#{tableColumnCode},#{preColumn})
    </insert>

    <insert id="saveTableColumnBatch">
        insert into tb_yunlankeji_table_column(id,tableName,columnName,columnDesc,columnLength,defaultValue,columnType,isKey,isNotNull,autoIncrement,tableCode,seq,tableColumnCode,preColumn)VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.id},#{item.tableName},#{item.columnName},#{item.columnDesc},#{item.columnLength},#{item.defaultValue},#{item.columnType},#{item.isKey},#{item.isNotNull},#{item.autoIncrement},#{item.tableCode},#{item.seq},#{item.tableColumnCode},#{item.preColumn})
        </foreach>
    </insert>


    <select id="queryTableColumn" parameterType="cn.pluss.platform.model.coding.TableColumn" resultType="cn.pluss.platform.model.coding.TableColumn">
        SELECT * from  tb_yunlankeji_table_column
        <where>
                <if test="id!= null and id!='' ">
                    and  id = #{ id}
                </if>
                <if test="tableName!= null and tableName!='' ">
                    and  tableName = #{ tableName}
                </if>
                <if test="columnName!= null and columnName!='' ">
