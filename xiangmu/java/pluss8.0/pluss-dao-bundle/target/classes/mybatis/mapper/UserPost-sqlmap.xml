	   	<insert id="saveUserPost" parameterType="cn.pluss.platform.model.auth.UserPost">
        	insert into tb_yunlankeji_user_post(userCode,postCode,tenant_id,corp_id,corp_name,institution_id,institution_name)VALUES(#{userCode},#{postCode},#{tenantId},#{corpId},#{corpName},#{institutionId},#{institutionName})
    	</insert>

	   	<insert id="saveUserPostBatch">
        	insert into tb_yunlankeji_user_post(userCode,postCode,tenant_id,corp_id,corp_name,institution_id,institution_name) VALUES
    			<foreach collection="list" item="item" index="index" separator=",">
			(#{item.userCode},#{item.postCode},#{item.tenantId},#{item.corpId},#{item.corpName},#{item.institutionId},#{item.institutionName})
				</foreach>
