<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.AssessmentStandardMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    level_name,
    template_id,
    score_start,
    score_end,
    score_result,
    serial_number,
    remark,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    is_deleted,
    status,
    assessment_suggest
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.levelName},
    #{item.templateId},
    #{item.scoreStart},
    #{item.scoreEnd},
    #{item.scoreResult},
    #{item.serialNumber},
    #{item.remark},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.isDeleted},
    #{item.status},
    #{item.assessmentSuggest}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_assessment_standard
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.AssessmentStandard">
        SELECT * from  tb_jiangyukeji_assessment_standard
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="levelName!=null and levelName!=''">
            and level_name = #{levelName}
        </if>
        <if test="templateId!=null and templateId!=''">
            and template_id = #{templateId}
        </if>
        <if test="scoreStart!=null and scoreStart!=''">
            and score_start = #{scoreStart}
        </if>
        <if test="scoreEnd!=null and scoreEnd!=''">
            and score_end = #{scoreEnd}
        </if>
        <if test="scoreResult!=null and scoreResult!=''">
            and score_result = #{scoreResult}
        </if>
        <if test="serialNumber!=null and serialNumber!=''">
            and serial_number = #{serialNumber}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        <if test="assessmentSuggest!=null and assessmentSuggest!=''">
            and assessment_suggest = #{assessmentSuggest}
        </if>
        </where>
        order by id desc limit #{pageSize} offset #{offset}
    </select>

    <select id="queryPageCount" parameterType="java.util.Map" resultType="java.lang.Integer">
        SELECT count(*) from tb_jiangyukeji_assessment_standard
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="levelName!=null and levelName!=''">
            and level_name = #{levelName}
        </if>
        <if test="templateId!=null and templateId!=''">
            and template_id = #{templateId}
        </if>
        <if test="scoreStart!=null and scoreStart!=''">
            and score_start = #{scoreStart}
        </if>
        <if test="scoreEnd!=null and scoreEnd!=''">
            and score_end = #{scoreEnd}
        </if>
        <if test="scoreResult!=null and scoreResult!=''">
            and score_result = #{scoreResult}
        </if>
        <if test="serialNumber!=null and serialNumber!=''">
            and serial_number = #{serialNumber}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        <if test="assessmentSuggest!=null and assessmentSuggest!=''">
            and assessment_suggest = #{assessmentSuggest}
        </if>
        </where>
    </select>
    <select id="queryAssessmentStandardsByTemplateId"
            resultType="cn.pluss.platform.model.entity.AssessmentStandard">
        SELECT * from  tb_jiangyukeji_assessment_standard
        where template_id = #{templateId}
    </select>
    <select id="queryAssessmentStandardsByTemplateIds"
            resultType="cn.pluss.platform.model.entity.AssessmentStandard">
        SELECT * from tb_jiangyukeji_assessment_standard
        WHERE template_id IN
        <foreach collection="templateIds" item="templateId" open="(" separator="," close=")">
            #{templateId}
        </foreach>
        AND (is_deleted = 0 OR is_deleted IS NULL)
    </select>

</mapper>

