					 </if> 
					<if test="organCode!= null  and organCode!='' "> 
					 	organCode = #{organCode}
					 </if> 
				</set>
			where id=#{id} 
		</update>

		<delete id="deleteUserOrgan" parameterType="cn.pluss.platform.model.auth.UserOrgan" >
			DELETE FROM tb_yunlankeji_user_organ where id=#{id}
		</delete>

		<delete id="deleteUserOrganBatch" parameterType="java.util.List" >
