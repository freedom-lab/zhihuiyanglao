<mapper namespace="cn.pluss.platform.mapper.base.auth.UserOrganMapper">

	   	<insert id="saveUserOrgan" parameterType="cn.pluss.platform.model.auth.UserOrgan">
        	insert into tb_yunlankeji_user_organ(userCode,organCode,tenant_id,corp_id,corp_name,institution_id,institution_name)VALUES(#{userCode},#{organCode},#{tenantId},#{corpId},#{corpName},#{institutionId},#{institutionName})
    	</insert>

	   	<insert id="saveUserOrganBatch">
        	insert into tb_yunlankeji_user_organ(userCode,organCode,tenant_id,corp_id,corp_name,institution_id,institution_name) VALUES
    			<foreach collection="list" item="item" index="index" separator=",">
			(#{item.userCode},#{item.organCode},#{item.tenantId},#{item.corpId},#{item.corpName},#{item.institutionId},#{item.institutionName})
				</foreach>
    	</insert>

		<select id="queryUserOrgan" parameterType="cn.pluss.platform.model.auth.UserOrgan" resultType="cn.pluss.platform.model.auth.UserOrgan">
			SELECT * from tb_yunlankeji_user_organ 
				<where> 
					<if test="id!= null and id!='' "> 
					 	and id = #{id}
					 </if> 
					<if test="userCode!= null and userCode!='' "> 
					 	and userCode = #{userCode}
					 </if> 
					<if test="organCode!= null and organCode!='' "> 
					 	and organCode = #{organCode}
					 </if>
					<if test="tenantId!= null and tenantId!='' ">
