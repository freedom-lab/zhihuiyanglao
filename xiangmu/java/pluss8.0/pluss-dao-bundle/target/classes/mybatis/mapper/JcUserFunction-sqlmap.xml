<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.pluss.platform.mapper.JcUserFunctionMapper">
    <sql id="tableFieldNames">
    (
    id,
    tenant_id,
    function_name,
    function_img,
    function_path,
    menu_id,
    create_user,
    create_dept,
    create_time,
    update_user,
    update_time,
    status,
    is_deleted,
    remark
    )
    </sql>
    <sql id="tableFiledUpcaseNames">
    (
    #{item.id},
    #{item.tenantId},
    #{item.functionName},
    #{item.functionImg},
    #{item.functionPath},
    #{item.menuId},
    #{item.createUser},
    #{item.createDept},
    #{item.createTime},
    #{item.updateUser},
    #{item.updateTime},
    #{item.status},
    #{item.isDeleted},
    #{item.remark}
    )
    </sql>
    <insert id="insertBatch">
        insert into tb_jiangyukeji_jc_user_function
        <include refid="tableFieldNames"/>
        values
        <foreach collection="list" item="item" separator=",">
            <include refid="tableFiledUpcaseNames"/>
        </foreach>
    </insert>

    <select id="queryPage" parameterType="java.util.Map" resultType="cn.pluss.platform.model.entity.JcUserFunction">
        SELECT * from  tb_jiangyukeji_jc_user_function
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="functionName!=null and functionName!=''">
            and function_name = #{functionName}
        </if>
        <if test="functionImg!=null and functionImg!=''">
            and function_img = #{functionImg}
        </if>
        <if test="functionPath!=null and functionPath!=''">
            and function_path = #{functionPath}
        </if>
        <if test="menuId!=null and menuId!=''">
            and menu_id = #{menuId}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        </where>
        order by id desc limit #{pageSize} offset #{offset}
    </select>

    <select id="queryPageCount" parameterType="java.util.Map" resultType="java.lang.Integer">
        SELECT count(*) from tb_jiangyukeji_jc_user_function
        <where>
        <if test="id!=null and id!=''">
            and id = #{id}
        </if>
        <if test="tenantId!=null and tenantId!=''">
            and tenant_id = #{tenantId}
        </if>
        <if test="functionName!=null and functionName!=''">
            and function_name = #{functionName}
        </if>
        <if test="functionImg!=null and functionImg!=''">
            and function_img = #{functionImg}
        </if>
        <if test="functionPath!=null and functionPath!=''">
            and function_path = #{functionPath}
        </if>
        <if test="menuId!=null and menuId!=''">
            and menu_id = #{menuId}
        </if>
        <if test="createUser!=null and createUser!=''">
            and create_user = #{createUser}
        </if>
        <if test="createDept!=null and createDept!=''">
            and create_dept = #{createDept}
        </if>
        <if test="createTime!=null and createTime!=''">
            and create_time = #{createTime}
        </if>
        <if test="updateUser!=null and updateUser!=''">
            and update_user = #{updateUser}
        </if>
        <if test="updateTime!=null and updateTime!=''">
            and update_time = #{updateTime}
        </if>
        <if test="status!=null and status!=''">
            and status = #{status}
        </if>
        <if test="isDeleted!=null and isDeleted!=''">
            and is_deleted = #{isDeleted}
        </if>
        <if test="remark!=null and remark!=''">
            and remark = #{remark}
        </if>
        </where>
    </select>

</mapper>

